{
  "manifestVersion": 5,
  "id": "com.liquidglass.photoshop",
  "name": "Sudo Liquid Glass",
  "version": "0.5.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.2.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "glassPanel",
      "label": { "default": "Sudo Liquid Glass" },
      "minimumSize": { "width": 240, "height": 360 },
      "maximumSize": { "width": 600, "height": 2000 },
      "preferredDockedSize": { "width": 260, "height": 560 },
      "preferredFloatingSize": { "width": 260, "height": 560 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "plugin" }
}
